# App
SECRET_KEY=change-me-to-a-random-string
DEBUG=true

# Database
# Local dev: use asyncpg/psycopg2 URLs directly.
# Render: set DATABASE_URL only (Render provides postgresql://, app auto-converts to asyncpg).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/conexperiment
# DATABASE_URL_SYNC is optional — if not set, derived from DATABASE_URL.
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/conexperiment

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (primary)
# Production (Render) typically uses N1N_API_KEY + LLM_API_BASE as the gateway.
# Locally you can use OPENAI_API_KEY instead.
N1N_API_KEY=
LLM_API_BASE=
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=20
LLM_MAX_CONCURRENT=30

# LLM (backup / fallback provider — optional)
LLM_BACKUP_API_BASE=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=gpt-4o-mini

# Chat controls (production defaults)
MIN_TURNS=5
MAX_TURNS=15
MAX_DURATION=600
HHC_TIMEOUT=120

# Encryption (for Prolific IDs at rest). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-with-python-cryptography-Fernet

# Admin
# Current implementation: SHA-256 hex digest of the password
#   python -c "import hashlib; print(hashlib.sha256(b'YOUR_PASSWORD').hexdigest())"
# Planned migration: bcrypt ($2b$...) — see routers/admin/auth.py module docstring.
ADMIN_PASSWORD_HASH=generate-with-sha256-or-bcrypt

# Prolific
PROLIFIC_COMPLETION_URL=
PROLIFIC_API_TOKEN=

# Demo Mode (for testing and presentations)
# Set to true to reduce turns/timeouts and skip Prolific checks
DEMO_MODE=false
DEMO_MIN_TURNS=2
DEMO_MAX_TURNS=5
DEMO_MAX_DURATION=300
DEMO_HHC_TIMEOUT=10
